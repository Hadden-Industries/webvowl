{
  "name": "webvowl",
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "packages/vowl"
  ],
  "dependencies": {
    "@hyperjump/uri": "1.4.0",
    "@streamparser/json": "0.0.26",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "canonicalize": "5.1.0",
    "d3": "^7.9.2",
    "owlapi": "npm:@hadden-industries/owlapi@0.1.0-rc.3"
  },
  "devDependencies": {
    "@eslint/js": ">=10.0.1",
    "@hadden-industries/json-quality": ">=1.0.0",
    "@hadden-industries/markdown-quality": ">=3.0.1",
    "@oddbird/popover-polyfill": ">=0.7.3",
    "archiver": ">=8.0.0",
    "deepmerge": "file:tooling/vendor/deepmerge",
    "dependency-cruiser": ">=18.7.2",
    "eslint": ">=10.14.0",
    "eslint-plugin-compat": ">=7.0.2",
    "globals": ">=17.14.0",
    "html-validate": ">=11.21.0",
    "jest": ">=30.5.2",
    "prettier": ">=3.9.10",
    "stylelint": ">=17.16.0",
    "stylelint-config-clean-order": ">=10.0.0",
    "stylelint-config-standard": ">=40.0.0",
    "stylelint-order": ">=8.1.3",
    "vite": ">=8.3.7",
    "vite-plugin-eslint2": ">=5.3.0",
    "vite-plugin-static-copy": ">=4.1.1",
    "vite-plugin-stylelint": ">=6.3.0",
    "yaml": ">=2.9.1"
  },
  "scripts": {
    "graph:dependencies": "node util/dependency-graph.mjs",
    "check:affected": "node util/affected-tests.mjs",
    "dev": "vite --open",
    "prebuild": "npm run format:app:check && npm run lint:app",
    "build": "npm run build:bundle",
    "build:bundle": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:vowl": "npm run check:corpus-storage && npm test -- --runInBand packages/vowl",
    "lint": "npm run lint:app && npm run lint:python && npm run check:docs && npm run check:json",
    "lint:app": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate src/index.html",
    "lint:js": "eslint src/ util/ packages/vowl/src/ packages/vowl/test/ packages/vowl/scripts/",
    "format": "npm run format:app && npm run format:python && npm run format:docs && npm run format:json",
    "format:check": "npm run format:app:check && npm run format:python:check && npm run check:docs && npm run format:json:check",
    "format:app": "prettier --write \"src/**/*.{js,css,html}\" \"{util,tooling}/**/*.{js,mjs,cjs}\" \"packages/vowl/{src,test}/**/*.js\" \"packages/vowl/scripts/*.mjs\"",
    "format:app:check": "prettier --check \"src/**/*.{js,css,html}\" \"{util,tooling}/**/*.{js,mjs,cjs}\" \"packages/vowl/{src,test}/**/*.js\" \"packages/vowl/scripts/*.mjs\"",
    "format:python": "node util/runRepositoryPython.mjs -I -m ruff format .",
    "format:python:check": "node util/runRepositoryPython.mjs -I -m ruff format --check .",
    "lint:python": "node util/runRepositoryPython.mjs -I -m ruff check .",
    "lint:python:fix": "node util/runRepositoryPython.mjs -I -m ruff check --fix .",
    "format:docs": "markdown-quality format --write --root . --diagnostic-display-level warning",
    "check:python": "npm run format:python:check && npm run lint:python && npm run test:setup",
    "check:docs": "markdown-quality check --root . --diagnostic-display-level warning",
    "check": "npm run format:app:check && npm run format:python:check && npm run lint && npm run check:corpus-storage && npm run test:setup && npm run test:markdown && npm run test:json && npm test -- --runInBand && npm run build:bundle && node util/verifyGeneratedRepositoryJson.mjs",
    "fix:all": "stylelint \"src/**/*.css\" --fix && eslint src/ util/ --fix && npm run lint:python:fix && npm run format",
    "zip": "node util/zip.mjs",
    "predeploy": "npm run build",
    "deploy": "python ./util/upload_to_s3.py",
    "setup:development": "node util/setUpDevelopmentEnvironment.mjs",
    "plan:skill-reconciliation": "node util/runRepositoryPython.mjs tools/repository-skills.pyz plan",
    "apply:skill-reconciliation-plan": "node util/runRepositoryPython.mjs tools/repository-skills.pyz apply",
    "test:setup": "node util/runRepositoryPython.mjs -I -B tools/repository-skills.pyz check && node util/runRepositoryPython.mjs -m unittest discover -s util -p test_*.py",
    "format:json:check": "node util/runRepositoryJsonQuality.mjs check",
    "check:json": "node util/runRepositoryJsonQuality.mjs check",
    "check:corpus-storage": "node --test util/corpusStorage.probes.mjs && node packages/vowl/scripts/verify-corpus-storage.mjs",
    "format:json": "node util/runRepositoryJsonQuality.mjs format --write",
    "normalize:json": "node util/runRepositoryJsonQuality.mjs normalize --write",
    "test:markdown": "node --test util/markdownIntegration.probes.mjs",
    "test:json": "node --test util/jsonIntegration.probes.mjs",
    "inspect:json": "node util/runRepositoryJsonQuality.mjs check --ndjson"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "owlapi": "$owlapi",
    "deepmerge": "$deepmerge",
    "glob@^10 || ^13": "14.0.4",
    "minimatch@>=7.0.0 <11.0.1": "11.0.5",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "5.5.0"
    }
  },
  "private": true,
  "jest": {
    "maxWorkers": 2,
    "testEnvironment": "node",
    "transform": {},
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/\\.sdlc/(?:runtime|tmp)/"
    ]
  },
  "browserslist": [
    "baseline widely available"
  ],
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.2",
      "onFail": "error"
    }
  }
}

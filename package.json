{
  "name": "webvowl",
  "version": "1.1.7",
  "dependencies": {
    "@rdfjs/data-model": "2.1.2",
    "@rdfjs/dataset": "2.0.3",
    "@xmldom/xmldom": "0.9.10",
    "d3": "^7.9.0",
    "jsonld": "9.0.0",
    "lodash": "^4.18.1",
    "n3": "2.2.0",
    "rdfxml-streaming-parser": "3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "archiver": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "globals": "^17.8.0",
    "html-validate": "^11.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "terser": "^5.49.0",
    "vite": "^8.1.5",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-eslint2": "^5.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-stylelint": "^6.3.0"
  },
  "scripts": {
    "dev": "vite --open",
    "prebuild": "npm run format:check && npm run lint",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate src/index.html",
    "lint:js": "eslint src/",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\"",
    "fix:all": "stylelint \"src/**/*.css\" --fix && eslint src/ --fix && npm run format",
    "zip": "node util/zip.mjs",
    "predeploy": "npm run build",
    "deploy": "python ./util/upload_to_s3.py"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": ["/node_modules/"]
  },
  "browserslist": [
    "baseline widely available"
  ]
}

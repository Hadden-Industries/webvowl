{
  "name": "webvowl",
  "version": "2.0.0",
  "type": "module",
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "d3": "^7.9.0",
    "lodash": "^4.18.1",
    "owlapi": "git+https://github.com/Hadden-Industries/owlapi.git#caabb1197ffdab91c1e10d596d177b5142aea5c1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oddbird/popover-polyfill": "^0.7.1",
    "@rollup/plugin-replace": "^6.0.2",
    "archiver": "^8.0.0",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "globals": "^17.12.0",
    "html-validate": "^11.16.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "terser": "^5.51.2",
    "vite": "^8.3.0",
    "vite-plugin-eslint2": "^5.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-stylelint": "^6.3.0",
    "yaml": "2.9.1"
  },
  "scripts": {
    "dev": "vite --open",
    "prebuild": "npm run format:app:check && npm run lint:app",
    "build": "npm run build:bundle",
    "build:bundle": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "lint": "npm run lint:app && npm run lint:python && npm run check:docs",
    "lint:app": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate src/index.html",
    "lint:js": "eslint src/ util/ tooling/",
    "format": "npm run format:app && npm run format:python && npm run format:docs",
    "format:check": "npm run format:app:check && npm run format:python:check && npm run format:docs:check",
    "format:app": "prettier --write \"src/**/*.{js,css,html}\" \"{util,tooling}/**/*.{js,mjs,cjs}\"",
    "format:app:check": "prettier --check \"src/**/*.{js,css,html}\" \"{util,tooling}/**/*.{js,mjs,cjs}\"",
    "format:python": "node util/runRepositoryPython.mjs -I -m ruff format .",
    "format:python:check": "node util/runRepositoryPython.mjs -I -m ruff format --check .",
    "lint:python": "node util/runRepositoryPython.mjs -I -m ruff check .",
    "lint:python:fix": "node util/runRepositoryPython.mjs -I -m ruff check --fix .",
    "format:docs": "prettier --write \"*.md\" \"docs/**/*.md\" && node util/runRepositoryPython.mjs tooling/prose/format_docs.py --write && prettier --write \"*.md\" \"docs/**/*.md\"",
    "format:docs:check": "prettier --check \"*.md\" \"docs/**/*.md\" && node util/runRepositoryPython.mjs tooling/prose/format_docs.py --check",
    "check:python": "npm run lint:python && npm run format:python:check && npm run test:setup && npm run test:prose",
    "check:docs": "npm run format:docs:check",
    "check": "npm run lint && npm run format:app:check && npm run format:python:check && npm run test:setup && npm run test:prose && npm test -- --runInBand && npm run build:bundle",
    "fix:all": "stylelint \"src/**/*.css\" --fix && eslint src/ util/ tooling/ --fix && npm run lint:python:fix && npm run format",
    "zip": "node util/zip.mjs",
    "predeploy": "npm run build",
    "deploy": "python ./util/upload_to_s3.py",
    "setup:development": "node util/setUpDevelopmentEnvironment.mjs",
    "test:setup": "node util/runRepositoryPython.mjs -m unittest discover -s util -p test_*.py",
    "test:prose": "node util/runRepositoryPython.mjs -m unittest discover -s tooling/prose -p test_format_docs.py"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/\\.sdlc/(?:runtime|tmp)/"
    ]
  },
  "browserslist": [
    "baseline widely available"
  ],
  "packageManager": "npm@12.0.2"
}

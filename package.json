{
  "name": "webvowl",
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "packages/vowl"
  ],
  "dependencies": {
    "@hyperjump/uri": "1.3.9",
    "@xmldom/xmldom": "0.9.12",
    "d3": "^7.9.0",
    "lodash": "^4.18.1",
    "owlapi": "npm:@hadden-industries/owlapi@0.1.0-rc.2"
  },
  "devDependencies": {
    "@eslint/js": ">=10.0.1",
    "@oddbird/popover-polyfill": ">=0.7.3",
    "@rollup/plugin-replace": ">=6.0.3",
    "archiver": ">=8.0.0",
    "cross-env": ">=10.1.0",
    "dependency-cruiser": ">=18.5.0",
    "eslint": ">=10.12.0",
    "eslint-config-prettier": ">=10.1.8",
    "eslint-plugin-compat": ">=7.0.2",
    "globals": ">=17.13.0",
    "html-validate": ">=11.16.2",
    "jest": ">=30.5.2",
    "prettier": ">=3.9.9",
    "stylelint": ">=17.16.0",
    "stylelint-config-clean-order": ">=10.0.0",
    "stylelint-config-standard": ">=40.0.0",
    "stylelint-order": ">=8.1.1",
    "terser": ">=5.51.2",
    "vite": ">=8.3.4",
    "vite-plugin-eslint2": ">=5.3.0",
    "vite-plugin-static-copy": ">=4.1.1",
    "vite-plugin-stylelint": ">=6.3.0",
    "yaml": ">=2.9.1"
  },
  "scripts": {
    "graph:dependencies": "node util/dependency-graph.mjs",
    "check:affected": "node util/affected-tests.mjs",
    "dev": "vite --open",
    "prebuild": "npm run format:app:check && npm run lint:app",
    "build": "npm run build:bundle",
    "build:bundle": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "test:vowl": "npm test -- --runInBand packages/vowl",
    "lint": "npm run lint:app && npm run lint:python && npm run check:docs",
    "lint:app": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate src/index.html",
    "lint:js": "eslint src/ util/ packages/vowl/src/ packages/vowl/test/ packages/vowl/scripts/",
    "format": "npm run format:app && npm run format:python && npm run format:docs",
    "format:check": "npm run format:app:check && npm run format:python:check && npm run format:docs:check",
    "format:app": "prettier --write \"src/**/*.{js,css,html}\" \"{util,tooling}/**/*.{js,mjs,cjs}\" \"packages/vowl/{src,test}/**/*.js\" \"packages/vowl/scripts/*.mjs\"",
    "format:app:check": "prettier --check \"src/**/*.{js,css,html}\" \"{util,tooling}/**/*.{js,mjs,cjs}\" \"packages/vowl/{src,test}/**/*.js\" \"packages/vowl/scripts/*.mjs\"",
    "format:python": "node util/runRepositoryPython.mjs -I -m ruff format .",
    "format:python:check": "node util/runRepositoryPython.mjs -I -m ruff format --check .",
    "lint:python": "node util/runRepositoryPython.mjs -I -m ruff check .",
    "lint:python:fix": "node util/runRepositoryPython.mjs -I -m ruff check --fix .",
    "format:docs": "npm --prefix tooling/markdown run format",
    "format:docs:check": "npm --prefix tooling/markdown run check",
    "check:python": "npm run lint:python && npm run format:python:check && npm run test:setup",
    "check:docs": "npm --prefix tooling/markdown run check",
    "check": "npm run lint && npm run format:app:check && npm run format:python:check && npm run test:setup && npm run test:markdown && npm test -- --runInBand && npm run build:bundle",
    "fix:all": "stylelint \"src/**/*.css\" --fix && eslint src/ util/ --fix && npm run lint:python:fix && npm run format",
    "zip": "node util/zip.mjs",
    "predeploy": "npm run build",
    "deploy": "python ./util/upload_to_s3.py",
    "setup:development": "node util/setUpDevelopmentEnvironment.mjs",
    "test:setup": "node util/runRepositoryPython.mjs -m unittest discover -s util -p test_*.py",
    "install:markdown": "npm ci --prefix tooling/markdown --ignore-scripts --no-audit --no-fund",
    "test:markdown": "node --test util/markdownIntegration.probes.mjs"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "owlapi": "$owlapi",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "5.4.3"
    }
  },
  "private": true,
  "jest": {
    "maxWorkers": 2,
    "testEnvironment": "node",
    "transform": {},
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/\\.sdlc/(?:runtime|tmp)/"
    ]
  },
  "browserslist": [
    "baseline widely available"
  ],
  "packageManager": "npm@12.2.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.0",
      "onFail": "error"
    }
  }
}

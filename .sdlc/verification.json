{
  "schemaVersion": 2,
  "profiles": {
    "focused": [
      {
        "name": "Working-tree whitespace",
        "argv": [
          "git",
          "diff",
          "--check"
        ]
      },
      {
        "name": "Generated Codex configuration",
        "argv": [
          "node",
          "util/runRepositoryPython.mjs",
          "util/set_up_sdlc.py",
          "--check"
        ]
      }
    ],
    "affected": [
      {
        "name": "Working-tree whitespace",
        "argv": [
          "git",
          "diff",
          "--check"
        ]
      },
      {
        "name": "Generated Codex configuration",
        "argv": [
          "node",
          "util/runRepositoryPython.mjs",
          "util/set_up_sdlc.py",
          "--check"
        ]
      },
      {
        "name": "Affected WebVOWL repository checks",
        "argv": [
          "node",
          "util/runAffectedChecks.mjs"
        ],
        "timeoutSeconds": 1200
      }
    ],
    "full": [
      {
        "name": "Working-tree whitespace",
        "argv": [
          "git",
          "diff",
          "--check"
        ]
      },
      {
        "name": "Generated Codex configuration",
        "argv": [
          "node",
          "util/runRepositoryPython.mjs",
          "util/set_up_sdlc.py",
          "--check"
        ]
      },
      {
        "name": "All automated checks for affected WebVOWL components",
        "argv": [
          "node",
          "util/runAffectedChecks.mjs"
        ],
        "timeoutSeconds": 1200
      }
    ]
  },
  "additionalFingerprintInputs": [
    ".sdlc/verification.json",
    ".node-version",
    ".python-version",
    "requirements-sdlc.txt",
    ".npmrc",
    "package.json",
    "package-lock.json",
    "skills-lock.json"
  ]

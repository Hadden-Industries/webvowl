{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haddenindustries.com/ontology/contracts/v1/ontology-seed-manifest.v1.schema.json",
  "title": "Reviewed seed publication input",
  "description": "Draft contract 1.0.0-draft.2; review artifact, not a deployed service promise.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "seed-manifest"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requestedDocumentIri": {
            "$ref": "ontology-contract-common.v1.schema.json#/$defs/requestedIri"
          },
          "sourceVersionIdentity": {
            "$ref": "ontology-contract-common.v1.schema.json#/$defs/digest"
          },
          "resolutionIdentity": {
            "$ref": "ontology-contract-common.v1.schema.json#/$defs/digest"
          },
          "rightsDecisionReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "reviewedAt": {
            "$ref": "ontology-contract-common.v1.schema.json#/$defs/timestamp"
          }
        },
        "required": [
          "requestedDocumentIri",
          "sourceVersionIdentity",
          "resolutionIdentity",
          "rightsDecisionReference",
          "reviewedAt"
        ],
        "additionalProperties": false
      },
      "description": "Bound by the normative serialized/aggregate catalog byte and work limits, not a permanent archive population ceiling."
    }
  },
  "required": ["schemaVersion", "kind", "entries"],
  "additionalProperties": false
}

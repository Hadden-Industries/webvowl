"id":"c10","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s45","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c100","kind":"data-range","property":"r7","target":"r36"},{"id":"c101","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s12","value":{"kind":"language","language":"en","lexical":"previous tag"}},{"id":"c102","kind":"sub-data-property","sub":"r39","super":"r38"},{"id":"c103","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s19","value":{"kind":"language","language":"en","lexical":"tagging modified"}},{"id":"c104","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s21","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c105","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s29","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c106","kind":"subclass","sub":"r11","super":"r32"},{"id":"c107","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s21","value":{"kind":"language","language":"en","lexical":"tag meaning"}},{"id":"c108","kind":"annotation-assertion","predicate":"http://www.w3.org/2002/07/owl#versionInfo","subject":"s44","value":{"datatype":"http://www.w3.org/2001/XMLSchema#string","kind":"typed","lexical":"Version 1.0: Earlier versions of MUTO defined a datatype property muto:tagPosition with integer values which has some drawbacks compared to this solution."}},{"id":"c109","kind":"inverse-properties","members":["r27","r40"]},{"id":"c11","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s12","value":{"kind":"language","language":"en","lexical":"This property indicates the tag that is preceding in the list of tags. It can be used to describe the order in which the tags have been entered by the user."}},{"id":"c110","kind":"annotation-assertion","predicate":"http://www.w3.org/2002/07/owl#versionInfo","subject":"s16","value":{"datatype":"http://www.w3.org/2001/XMLSchema#string","kind":"typed","lexical":"Version 1.0: The subproperty relation to rdfs:label has been removed for OWL DL conformance (rdfs:label is an annotation property and one cannot define subproperties for annotation properties in OWL DL)."}},{"id":"c111","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s42","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c112","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s15","value":{"kind":"language","language":"en","lexical":"has creator"}},{"id":"c113","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s40","value":{"kind":"language","language":"en","lexical":"An automatic tag is a tag that is automatically associated with a resource (e.g. by a tagging system), i.e. it is not entered by a human being."}},{"id":"c114","kind":"object-range","property":"r25","target":"r11"},{"id":"c115","kind":"annotation-assertion","predicate":"http://www.w3.org/2002/07/owl#versionInfo","subject":"s40","value":{"datatype":"http://www.w3.org/2001/XMLSchema#string","kind":"typed","lexical":"Version 1.0: muto:AutoTag was a subclass of muto:Tagging (called muto:autoTagging) in earlier versions. Defining it as a subclass of muto:Tag is more appropriate and allows for taggings that contain a combination of manually and automatically created tags."}},{"id":"c116","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s38","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c117","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s45","value":{"kind":"language","language":"en","lexical":"A Tag consists of an arbitrary text label. Note that tags with the same label are NOT merged in the ontology."}},{"id":"c118","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s44","value":{"kind":"language","language":"en","lexical":"This property indicates the tag that follows next in the list of tags. It can be used to describe the order in which the tags have been entered by the user."}},{"id":"c119","kind":"object-domain","property":"r3","target":"r28"},{"id":"c12","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s24","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c120","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s0","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c121","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s6","value":{"kind":"language","language":"en","lexical":"creator of"}},{"id":"c13","kind":"object-range","property":"r15","target":"r12"},{"id":"c14","kind":"inverse-properties","members":["r35","r41"]},{"id":"c15","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s24","value":{"kind":"language","language":"en","lexical":"A private tagging is a tagging that is only visible to its creator (unless the creator has not granted access to others via muto:grantAccess). Every tagging that is not an instance of muto:PrivateTagging is public by default."}},{"id":"c16","kind":"annotation-assertion","predicate":"http://www.w3.org/2002/07/owl#versionInfo","subject":"s29","value":{"datatype":"http://www.w3.org/2001/XMLSchema#string","kind":"typed","lexical":"Version 1.0: The range information has been removed for greater flexibility and OWL Lite conformance (no longer owl:unionOf). Classes from different vocabularies can now be used here - such as sioc:UserAccount, sioc:Usergroup, foaf:OnlineAccount, foaf:Group, or dcterms:Agent -, though we recommend the use of sioc:UserAccount or sioc:Usergroup to remain in the SIOC namespace."}},{"id":"c17","kind":"object-domain","property":"r41","target":"r11"},{"id":"c18","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s24","value":{"kind":"language","language":"en","lexical":"Private Tagging"}},{"id":"c19","kind":"annotation-assertion","predicate":"http://www.w3.org/2002/07/owl#versionInfo","subject":"s45","value":{"datatype":"http://www.w3.org/2001/XMLSchema#string","kind":"typed","lexical":"Version 1.0: The owl:disjointWith statement was removed to make MUTO conform to OWL Lite (the statement is not essential in this case)."}},{"id":"c2","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s20","value":{"kind":"language","language":"en","lexical":"The number of tags that can be linked to one and the same meaning is theoretically unlimited."}},{"id":"c21","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s40","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c22","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s33","value":{"kind":"language","language":"en","lexical":"has tag"}},{"id":"c23","kind":"object-range","property":"r3","target":"r12"},{"id":"c24","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s15","value":{"kind":"language","language":"en","lexical":"Every tagging is linked to at most one user account. This property can be omitted for automatic taggings. In contrast to its superproperty sioc:has_creator, it is functional and with an explicit domain. Use sioc:member_of to define groups for group tagging or link to foaf:Agent, foaf:Person, or foaf:Group via sioc:account_of."}},{"id":"c27","kind":"annotation-assertion","predicate":"http://www.w3.org/2002/07/owl#versionInfo","subject":"s12","value":{"datatype":"http://www.w3.org/2001/XMLSchema#string","kind":"typed","lexical":"Version 1.0: see muto:nextTag"}},{"id":"c28","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s7","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c29","kind":"object-domain","property":"r0","target":"r12"},{"id":"c3","kind":"annotation-assertion","predicate":"http://www.w3.org/2002/07/owl#versionInfo","subject":"s0","value":{"datatype":"http://www.w3.org/2001/XMLSchema#string","kind":"typed","lexical":"Version 1.0: see muto:grantAccess"}},{"id":"c30","kind":"inverse-properties","members":["r25","r33"]},{"id":"c31","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s42","value":{"kind":"language","language":"en","lexical":"A resource can have several taggings from different users. Tags are never directly linked to resources but can be inferred from the taggings."}},{"id":"c32","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s16","value":{"kind":"language","language":"en","lexical":"Every tag has exactly one label (usually the one given by the user) - otherwise it is not a tag. Additional labels can be defined in the resource that is linked via muto:tagMeaning."}},{"id":"c33","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s16","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c34","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s42","value":{"kind":"language","language":"en","lexical":"tagged with"}},{"id":"c35","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s0","value":{"kind":"language","language":"en","lexical":"A user account or user group can have access to a private tagging from another user if the access is explicitly permitted by the creator of the tagging. This property can also be used in public tagging to link a user account or user group to a tagging (e.g. if the creator of a tagging has suggested the tagging to another user)."}},{"id":"c36","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s5","value":{"kind":"language","language":"en","lexical":"tag of"}},{"id":"c37","kind":"object-domain","property":"r40","target":"r12"},{"id":"c38","kind":"object-domain","property":"r35","target":"r12"},{"id":"c39","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s19","value":{"kind":"language","language":"en","lexical":"A tagging can have multiple modification dates, as the number of times a tagging can be edited (e.g. to add or remove tags) is theoretically unlimited. The datatype of this property is xsd:dateTime (in contrast to it superproperty dcterms:created which has range rdfs:Literal)."}},{"id":"c4","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s21","value":{"kind":"language","language":"en","lexical":"The meaning of a tag can be expressed by a link to a well-defined resource. This can be any resource that clarifies the meaning of the tag (e.g. some DBpedia resource)."}},{"id":"c40","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s38","value":{"kind":"language","language":"en","lexical":"Tagging"}},{"id":"c41","kind":"object-range","property":"r17","target":"r11"},{"id":"c42","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s0","value":{"kind":"language","language":"en","lexical":"has access"}},{"id":"c43","kind":"object-range","property":"r6","target":"r11"},{"id":"c44","kind":"sub-object-property","sub":"r0","super":"r21"},{"id":"c45","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s20","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c46","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s19","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c47","kind":"data-range","property":"r37","target":"r36"},{"id":"c48","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s30","value":{"kind":"language","language":"en","lexical":"tagged resource"}},{"id":"c49","kind":"object-range","property":"r0","target":"r28"},{"id":"c5","kind":"inverse-properties","members":["r0","r3"]},{"id":"c50","kind":"sub-data-property","sub":"r37","super":"r23"},{"id":"c51","kind":"subclass","sub":"r12","super":"r18"},{"id":"c52","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s12","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c53","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s29","value":{"kind":"language","language":"en","lexical":"A (usually private) tagging can be linked to one or more user accounts or user groups that should have access to it (apart from the creator). This property can also be used in public tagging to link a user account or user group to a tagging (e.g. if the creator of a tagging wants to suggest the tagging to another user)."}},{"id":"c55","kind":"data-range","property":"r24","target":"r43"},{"id":"c56","kind":"data-domain","property":"r7","target":"r12"},{"id":"c57","kind":"inverse-properties","members":["r17","r6"]},{"id":"c58","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s14","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c59","kind":"subclass","sub":"r26","super":"r11"},{"id":"c6","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s30","value":{"kind":"language","language":"en","lexical":"Every tagging is linked to exactly one resource. This can be any kind of resource (i.e. all subclasses of rdfs:Resource), including tags and taggings."}},{"id":"c60","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s44","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c61","kind":"subclass","sub":"r42","super":"r12"},{"id":"c62","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s32","value":{"kind":"language","language":"en","lexical":"automatic tag meaning"}},{"id":"c63","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s33","value":{"kind":"language","language":"en","lexical":"A tagging consists of a (theoretically unlimited) number of tags. A tagging may also consist of no tags, e.g. if the system allows its users to mark a resource first and add tags later."}},{"id":"c64","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s32","value":{"kind":"language","language":"en","lexical":"This subproperty indicates that the meaning of a tag has been automatically defined (e.g. by a tagging system), i.e. it has not been defined by a human being. The default case is disambiguation by users via muto:tagMeaning."}},{"id":"c65","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s6","value":{"kind":"language","language":"en","lexical":"A user account can have a (theoretically unlimited) number of taggings. Use sioc:member_of to define groups for group tagging or link to foaf:Agent, foaf:Person, or foaf:Group via sioc:account_of."}},{"id":"c66","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s38","value":{"kind":"language","language":"en","lexical":"A tagging links a resource to a user account and one or more tags."}},{"id":"c67","kind":"object-range","property":"r35","target":"r11"},{"id":"c68","kind":"data-range","property":"r39","target":"r36"},{"id":"c69","kind":"object-range","property":"r27","target":"r12"},{"id":"c7","kind":"data-domain","property":"r24","target":"r11"},{"id":"c70","kind":"sub-object-property","sub":"r2","super":"r33"},{"id":"c71","kind":"sub-data-property","sub":"r7","super":"r23"},{"id":"c72","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s14","value":{"kind":"language","language":"en","lexical":"The creation date and time of a tag. This property can be omitted if muto:taggingCreated = muto:tagCreated (i.e. in the common case that a tag has been created along with a tagging, not in a later edit of the tagging). The datatype of this property is xsd:dateTime (in contrast to it superproperty dcterms:created which has range rdfs:Literal)."}},{"id":"c73","kind":"inverse-properties","members":["r14","r15"]},{"id":"c76","kind":"object-range","property":"r41","target":"r12"},{"id":"c77","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s33","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c78","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s14","value":{"kind":"language","language":"en","lexical":"tag created"}},{"id":"c79","kind":"object-domain","property":"r6","target":"r11"},{"id":"c8","kind":"data-domain","property":"r39","target":"r12"},{"id":"c80","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s7","value":{"kind":"language","language":"en","lexical":"Every tagging has exactly one creation date and time. The datatype of this property is xsd:dateTime (in contrast to its superproperty dcterms:created which has range rdfs:Literal)."}},{"id":"c81","kind":"data-domain","property":"r37","target":"r11"},{"id":"c83","kind":"object-domain","property":"r33","target":"r11"},{"id":"c84","kind":"object-domain","property":"r2","target":"r11"},{"id":"c85","kind":"sub-object-property","sub":"r3","super":"r30"},{"id":"c86","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#comment","subject":"s5","value":{"kind":"language","language":"en","lexical":"Every tag is linked to exactly one tagging. This results from the fact that tags with same labels are NOT merged in the ontology."}},{"id":"c87","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s16","value":{"kind":"language","language":"en","lexical":"tag label"}},{"id":"c88","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s6","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c89","kind":"object-domain","property":"r14","target":"r12"},{"id":"c9","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s45","value":{"kind":"language","language":"en","lexical":"Tag"}},{"id":"c90","kind":"object-domain","property":"r17","target":"r11"},{"id":"c91","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s7","value":{"kind":"language","language":"en","lexical":"tagging created"}},{"id":"c92","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#isDefinedBy","subject":"s30","value":{"iri":"http://purl.org/muto/core#","kind":"iri"}},{"id":"c93","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s20","value":{"kind":"language","language":"en","lexical":"meaning of"}},{"id":"c94","kind":"annotation-assertion","predicate":"http://www.w3.org/2000/01/rdf-schema#label","subject":"s29","value":{"kind":"language","language":"en","lexical":"grant access"}},{"id":"c95","kind":"annotation-assertion","pre